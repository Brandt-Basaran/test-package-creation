{
    "name": "CDK Import POC",
    "entryPoints": ["lib/*.ts"],
    "entryPointStrategy": "expand",
    "out": "docs",
    "plugin": ["typedoc-plugin-markdown"],
    "excludePrivate": true,
    "excludeExternals": true,
    "theme": "markdown",
    "readme": "README.md",
    "includeVersion": true,
    "$schema": "https://typedoc.org/schema.json",
  }